{
  "name": "diceonrails",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://www.diceonrails.com",
  "type": "module",
  "scripts": {
    "dev": "node scripts/preflight.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --bail=1",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --bail=1 --reporter=verbose",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "check:jsonclone": "rg -n 'JSON\\.parse\\(JSON\\.stringify\\(' --type ts || echo '0 matches'",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live/",
    "test:live:tier3": "npx tsx tests/live/run_all.ts",
    "test:all": "npm test && npm run test:live:tier3",
    "install-app": "node scripts/install.js",

    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.2.3",
    "inquirer": "^13.2.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",

    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.2",
    "vercel": "^35.0.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
