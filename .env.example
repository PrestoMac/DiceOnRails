# ─── AI Narration (Required) ─────────────────────────────────────
# API key for LLM narration. Works with OpenRouter (default) or any
# OpenAI-compatible provider. Get a key at: https://openrouter.ai/keys
#
# For local dev, set VITE_LLM_API_BASE to your provider's endpoint:
#   https://opencode.ai/zen/go/v1, https://api.openai.com/v1, etc.
#
# For production (Vercel), set VITE_LLM_API_BASE=/api to use the
# built-in proxy (avoids CORS issues). See api/chat/completions.ts.
#
# The LLM handles storytelling and suggests game mechanics via function calling.
# Tool calls are validated and merged with heuristic intent detection before execution.
VITE_LLM_API_KEY=

# API base URL — defaults to OpenRouter. Use /api in production to route
# through the Vercel serverless proxy (solves CORS).
VITE_LLM_API_BASE=https://openrouter.ai/api/v1

# Model to use for narration (any model ID supported by your provider)
# Default: deepseek/deepseek-v4-flash
# See all models: https://openrouter.ai/models
VITE_LLM_MODEL=deepseek/deepseek-v4-flash

# Separate summarization model for checkpoint compression.
# A fast, non-thinking model compresses old session history into dense summaries,
# keeping the main model's context focused on storytelling instead of re-processing
# raw history. Runs asynchronously in the background — never blocks the player's turn.
VITE_SUMMARIZATION_MODEL=xiaomi/mimo-v2.5

# ─── Image Generation (Optional) ─────────────────────────────────
# Get your key at: https://imagerouter.io
# Leave blank to disable atmosphere images
VITE_IMAGE_ROUTER_API_KEY=

# Model for scene image generation
# Default: stabilityai/sdxl-turbo
VITE_IMAGE_MODEL=stabilityai/sdxl-turbo

# ─── Context Management (Optional) ────────────────────────────────
# Token thresholds for the episodic checkpoint pipeline
# Frozen raw history is compressed into episode checkpoints (~4K tok each)
# which stack until the total budget is exceeded, then oldest are evicted.
# No mega-summary/merge pipeline — episodes persist independently.
# Defaults: RAW_CAP=30000 BUDGET=180000
# VITE_CONTEXT_RAW_CAP=30000
# VITE_CONTEXT_BUDGET=180000

# Model for checkpoint compression (default: xiaomi/mimo-v2.5)
# Uses a non-thinking model for fast, deterministic summarization
# VITE_SUMMARIZATION_MODEL=xiaomi/mimo-v2.5

# ─── Supabase (Required for multiplayer & cloud saves) ────────────
# Create a project at: https://supabase.com
# Then go to: Project Settings > API
VITE_SUPABASE_URL=

# Use the anon/public key, NOT the service_role secret
VITE_SUPABASE_ANON_KEY=
